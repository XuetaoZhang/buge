# Monad mainnet defaults. Replace these with the event-approved network when necessary.
VITE_MONAD_CHAIN_ID=143
VITE_MONAD_RPC_URL=https://rpc.monad.xyz
VITE_MONAD_NETWORK_NAME=Monad
VITE_MONAD_EXPLORER=https://explorer.monad.xyz

# Set after `npm run deploy`.
VITE_BUGE_CONTRACT_ADDRESS=
VITE_BUGE_EVENT_ID=1

# Local deployment only. Use a dedicated wallet with only test funds.
DEPLOYER_PRIVATE_KEY=

# Vercel API only. The relay account must equal the event attestor address.
MONAD_RPC_URL=
ATTESTOR_PRIVATE_KEY=
BUGE_CONTRACT_ADDRESS=
NFC_TAP_TOKEN=

# Short tap codes: JSON mapping of code → {eventId, token}
# NFC URL becomes: https://your-domain.com/tap?code=xxx
TAP_CODES={}
